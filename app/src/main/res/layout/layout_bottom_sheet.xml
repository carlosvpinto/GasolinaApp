<?xml version="1.0" encoding="utf-8"?>
<!-- La raíz de este archivo es el NestedScrollView con sus comportamientos -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_details"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet"
    android:elevation="16dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:behavior_fitToContents="false"
    app:behavior_halfExpandedRatio="0.55"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Rayita gris redondeada indicadora -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#D1D5DB"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- CABECERA COMPACTA: Logo, Nombre, Distancia y Botón IR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivStationLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/gasolina_1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A 0.0 km"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="IR"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2563EB"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_menu_directions"
                app:iconPadding="4dp"
                app:iconTint="#FFFFFF" />
        </LinearLayout>

        <!-- SIMULADOR DE AHORRO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="SIMULADOR DE AHORRO"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentVehicle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Promedio USA"
                        android:textSize="12sp"
                        android:textColor="#38BDF8"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">

                        <ProgressBar
                            android:id="@+id/pbTanqueGrafico"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="45dp"
                            android:layout_height="75dp"
                            android:progressDrawable="@drawable/bg_tanque_simulador"
                            android:max="100"
                            android:progress="100" />

                        <TextView
                            android:id="@+id/tvPorcentajeTanque"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="100%"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AHORRO NETO"
                            android:textSize="11sp"
                            android:textColor="#888888" />

                        <TextView
                            android:id="@+id/tvSavings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/savings_green" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvGalonesSimulador"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14.0 gal"
                                android:textSize="12sp"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" • "
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:layout_marginHorizontal="4dp"/>

                            <TextView
                                android:id="@+id/tvPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00 / gal"
                                android:textSize="12sp"
                                android:textColor="#888888" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderTank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:stepSize="0.1"
                    android:valueFrom="0.0"
                    android:valueTo="14.0"
                    android:value="14.0"
                    app:haloColor="#4DFFB300"
                    app:thumbColor="#FFB300"
                    app:trackColorActive="#FFB300"
                    app:trackColorInactive="#333333" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Título y Lista -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="ESTACIONES CERCANAS"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGasStations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>